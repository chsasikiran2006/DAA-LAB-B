import sys

def prim(graph):
    n = len(graph)

    selected = [False] * n
    key = [sys.maxsize] * n
    parent = [-1] * n

    # Start from vertex 0
    key[0] = 0

    for _ in range(n):
        # Find vertex with minimum key
        u = -1
        min_value = sys.maxsize

        for v in range(n):
            if not selected[v] and key[v] < min_value:
                min_value = key[v]
                u = v

        selected[u] = True

        # Update adjacent vertices
        for v in range(n):
            if graph[u][v] != 0 and not selected[v]:
                if graph[u][v] < key[v]:
                    key[v] = graph[u][v]
                    parent[v] = u

    # Print MST
    print("Edge\tWeight")
    total = 0

    for i in range(1, n):
        print(parent[i], "-", i, "\t", graph[i][parent[i]])
        total += graph[i][parent[i]]

    print("Total weight:", total)


graph = [
    [0, 2, 0, 6, 0],
    [2, 0, 3, 8, 5],
    [0, 3, 0, 0, 7],
    [6, 8, 0, 0, 9],
    [0, 5, 7, 9, 0]
]

prim(graph)